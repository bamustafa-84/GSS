# PostgreSQL connection settings.
# Copy this file to `.env` and adjust the values for your environment.
PGHOST=localhost
PGPORT=5432
PGUSER=sa
PGPASSWORD=sa
PGDATABASE=gss_tc

# Optional connection-pool tuning.
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONNECTION_TIMEOUT=10000

# Set to "true" to require SSL (e.g. for managed/cloud PostgreSQL).
PGSSL=false
