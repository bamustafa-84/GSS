# PostgreSQL connection settings (local test).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=sa
PGDATABASE=gss_tc

# Optional connection-pool tuning.
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONNECTION_TIMEOUT=10000

# HTTP server port.
PORT=3000

# Set to "true" to require SSL (e.g. for managed/cloud PostgreSQL).
PGSSL=false

# ── Email notifications (optional) ─────────────────────────────────
# Account-notification emails are sent only when SMTP_HOST and MAIL_FROM are
# set AND the `nodemailer` package is installed. Otherwise the app silently
# skips delivery (account creation/updates still succeed).
# Never commit real credentials — keep them in the untracked .env file.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GSS Training Centre <no-reply@example.com>"

# Public base URL used to build login / password-setup links in emails.
APP_BASE_URL=http://localhost:3000
